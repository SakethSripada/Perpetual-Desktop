{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Perpetual",
  "version": "0.1.0",
  "identifier": "dev.perpetual.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1437",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Perpetual",
        "width": 1320,
        "height": 860,
        "minWidth": 900,
        "minHeight": 640,
        "decorations": false,
        "backgroundColor": "#181818"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; connect-src ipc: http://ipc.localhost; font-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "shortDescription": "A persistent workspace for Codex and Claude",
    "category": "DeveloperTool"
  }
}
